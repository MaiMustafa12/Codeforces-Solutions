#include <iostream>
#include <algorithm>
 
using namespace std;
 
int main() {
    int s[4];
    for (int i = 0; i < 4; i++) {
        cin >> s[i];
    }
 
    sort(s, s + 4);
 
    int unique_count = 1;
    for (int i = 1; i < 4; i++) {
        if (s[i] != s[i - 1]) {
            unique_count++;
        }
    }
 
    cout << 4 - unique_count << endl;
 
    return 0;
}